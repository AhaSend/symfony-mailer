{
    "name": "ahasend/symfony-mailer",
    "type": "symfony-mailer-bridge",
    "description": "AhaSend Mailer Bridge: the Symfony 8.2 bridge, with API v2 and webhooks, for Symfony 7.4, 8.0 and 8.1",
    "keywords": ["ahasend", "mailer", "symfony"],
    "homepage": "https://ahasend.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Farhad Hedayatifard",
            "email": "farhad@ahasend.com"
        },
        {
            "name": "Symfony Community",
            "homepage": "https://symfony.com/contributors"
        }
    ],
    "require": {
        "php": ">=8.2",
        "psr/event-dispatcher": "^1",
        "symfony/deprecation-contracts": "^2.5|^3",
        "symfony/http-client": "^7.4|^8.0",
        "symfony/mailer": "^7.4|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.50",
        "symfony/clock": "^7.4|^8.0",
        "symfony/framework-bundle": "^7.4|^8.0",
        "symfony/messenger": "^7.4|^8.0",
        "symfony/phpunit-bridge": "^7.4|^8.0",
        "symfony/remote-event": "^7.4|^8.0",
        "symfony/webhook": "^7.4|^8.0"
    },
    "replace": {
        "symfony/aha-send-mailer": "^7.4|^8.0"
    },
    "suggest": {
        "symfony/webhook": "Receives AhaSend webhooks as remote events"
    },
    "autoload": {
        "psr-4": { "Symfony\\Component\\Mailer\\Bridge\\AhaSend\\": "" },
        "files": [ "Resources/polyfill.php" ],
        "exclude-from-classmap": [
            "/Tests/",
            "/Resources/polyfill/"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
